# Copy this file to .env and fill in the values. Never commit .env.

# Agent backend: anthropic | droid | scripted | replay. The runner falls back along AGENT_FALLBACK.
AGENT_BACKEND=scripted
AGENT_FALLBACK=scripted
# Record successful model runs to backend/recordings/ for replay: 1 (default), 0, or force (record scripted too)
RECORD_RUNS=1

# Anthropic API (the real model path and the stage fallback for Droid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Per-role override: ANTHROPIC_MODEL_MAPPER, ANTHROPIC_MODEL_PREPARER, ANTHROPIC_MODEL_REVIEWER

# Factory Droid SDK (agent runner for the Factory track). Needs the `droid` CLI on PATH.
FACTORY_API_KEY=
# A model id from scripts/droid_probe.py. Default is Claude Haiku 5.5 to keep the weekend cheap.
DROID_MODEL=claude-haiku-5-5
# Per-role override, for example a stronger model for the Mapper, which holds the judgment:
DROID_MODEL_MAPPER=claude-sonnet-5-5
# Reasoning effort is pinned too (off|low|medium|high|xhigh|max, per model). Droid picks high when none is given.
DROID_REASONING_EFFORT=medium
# DROID_REASONING_EFFORT_MAPPER=high
# Droid's own router is the model id `auto`. Never set DROID_MODEL=auto: the run would not name its model.
# Optional: comma list for SessionConfig.restrict_tools; empty means only our MCP tools
DROID_RESTRICT_TOOLS=
DROID_TIMEOUT=75
# Each role keeps one Droid session in its own empty folder here, and resumes it on its next turn
# DROID_WORKDIR=~/.cache/stochastic/droid

# Store: memory (default) or postgres. postgres writes the record through to Tiger Cloud and loads it back on start.
# If the database cannot be reached, the API starts in memory and /health says why.
STORE=memory
# The Tiger Cloud service URL, with the password (from the service's credentials file). Never commit it.
DATABASE_URL=
# One API process writes a schema at a time (advisory lock). Use your own name when you run against Tiger.
DB_SCHEMA=stochastic
# What-ifs of a covenant flag in a Tiger fork (tiger: on; needs STORE=postgres and the `tiger` CLI logged in).
# The free plan allows one fork beside the main service. TIGER_SERVICE_ID is the main service's id.
FORKS=off
TIGER_SERVICE_ID=

# SEC EDGAR requires a User-Agent with a real contact email (data pulls only; the demo makes no live SEC calls)
SEC_USER_AGENT="Stochastic research your-team-email@example.com"
