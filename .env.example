# Copy this file to .env and fill in the values. Never commit .env.

# Models
ANTHROPIC_API_KEY=

# Database (Postgres on Tiger Cloud)
DATABASE_URL=

# SEC EDGAR requires a User-Agent with a real contact email
SEC_USER_AGENT="Stochastic research your-team-email@example.com"

# Factory Droid SDK (agent runner). Real value goes in .env only.
FACTORY_API_KEY=
# anthropic or droid
AGENT_BACKEND=anthropic
